{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "student-content.schema.json",
  "title": "Student content",
  "description": "The only JSON the student HTML renderer may read. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_id", "title", "parts"],
  "properties": {
    "schema_version": { "const": "student-content.v1" },
    "lesson_id": { "type": "string" },
    "title": { "type": "string" },
    "credits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Short source labels shown at the end of the lesson."
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nav_label", "blocks"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["hook", "minds-on", "action", "consolidation"]
        },
        "nav_label": { "type": "string" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "p" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "h2" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "equation" },
            "text": { "type": "string" }
          },
          "required": ["type", "text"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "task" },
            "prompt": { "type": "string" }
          },
          "required": ["type", "prompt"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "figure" },
            "src": { "type": "string" },
            "alt": { "type": "string" }
          },
          "required": ["type", "src", "alt"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "interactive" },
            "spec_id": { "type": "string" }
          },
          "required": ["type", "spec_id"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "practice-set" },
            "set_id": { "type": "string" },
            "visible_count": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "set_id"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "example" },
            "stage": {
              "type": "string",
              "enum": ["worked", "variation", "partial", "independent", "retrieval"]
            },
            "blocks": {
              "type": "array",
              "items": { "$ref": "#/$defs/block" }
            }
          },
          "required": ["type", "stage", "blocks"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": { "const": "self-check" },
            "prompt": { "type": "string" },
            "rubric_id": { "type": "string" }
          },
          "required": ["type", "prompt"]
        }
      ]
    }
  }
}
