# Downloaded source collections (OpenStax, WeBWorK, datasets)
cache/

# Rebuildable search index — not the school LMS database
index/*.sqlite
index/*.sqlite-journal
index/*.db
index/*.duckdb

# Isolated Python env and Node installs
.venv/
node_modules/

# Playwright output
playwright-report/
test-results/
blob-report/

# Worktree scratch if a script accidentally writes here
.tmp/

# Import rollback snapshots (regenerated by --apply)
catalogue/onboarding/*/batches/*/rollback/
