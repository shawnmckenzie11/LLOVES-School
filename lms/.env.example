# Copy to lms/.env (gitignored). Full Cloud Console steps: lms/GOOGLE.md

FLASK_SECRET_KEY=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on the Web client (127.0.0.1 ≠ localhost).
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
IT_EMAILS=solutions@mckenzian.com

# Local/dev only: show the 6-digit first-login code on the verify page when
# Resend/SMTP is not configured. Ignored when FLASK_ENV=production (the code
# is never displayed in production).
ALLOW_DEV_VERIFICATION_CODE=1

# First-login email (required in production). Prefer Resend; SMTP is the fallback.
# Set at least one path. Do not commit real keys.
# RESEND_API_KEY=
# EMAIL_FROM=LLOVES <noreply@mckenzian.com>
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_SSL=0
# SMTP_SENDER=

# Set to 1 for local testing to use the offline account picker.
# Leave unset in production so real Google OAuth is used.
LOCAL_DEV_LOGIN=
